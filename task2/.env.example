# Rename this file to .env. NEVER commit secrets to Git.
OPENSEARCH_URL=http://localhost:9200
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Obtain and configure the trusted Russian CA certificate for TLS.
# GIGACHAT_CA_BUNDLE_FILE=/absolute/path/to/Russian_Trusted_Root_CA.crt
GIGACHAT_VERIFY_SSL_CERTS=true

# A/B experiments (defaults keep Task 2 original behavior).
OPENSEARCH_INDEX_NAME=task2_client_knowledge_v1
NEWS_QUERY_MODE=balanced
NEWS_TITLE_BOOST=4
NEWS_CONTENT_BOOST=1
# 0 means no chunking; after changing these re-run: python -m src.cli index
NEWS_CHUNK_SIZE=0
NEWS_CHUNK_OVERLAP=100
# Optional: config/prompts/strict_risk_first.txt (must return same JSON schema)
GIGACHAT_PROMPT_FILE=
PPTX_THEME=teal
